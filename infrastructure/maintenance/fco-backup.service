DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=/home/no-rules/projects/12_sornnet_prediction/sornette_prediction/infrastructure/maintenance/backup_to_gdrive.sh
